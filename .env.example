# Domain for the dashboard and agent connection
DOMAIN=localhost
# Email for Let's Encrypt (if using public domain)
ACME_EMAIL=admin@example.com
# Admin password for the dashboard
ADMIN_PASSWORD=turtle2025
# MQTT Broker URL for the controller (internal docker network)
MQTT_BROKER=tcp://mqtt:1883
# MQTT Broker URL for agents (external access). This MUST be an address
# robots on your LAN can actually reach -- "localhost" here means the ROBOT's
# own loopback, not the controller, and agents will never connect. Use the
# controller host's real LAN IP, e.g. tcp://192.168.1.100:1883.
AGENT_MQTT_BROKER=tcp://192.168.1.100:1883
# Subnets to scan for robots (CIDR)
SCAN_SUBNETS=192.168.1.0/24
